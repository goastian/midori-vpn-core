# Nginx stream{} reverse proxy for TLS-encrypted proxy and tunnel traffic.
# Place this file under /etc/nginx/stream.d/

upstream vpn_core_connect_proxy_backend {
    server 127.0.0.1:__PROXY_HOST_PORT__;
}

server {
    listen __PROXY_PUBLIC_PORT__ ssl;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL_STREAM:10m;

    proxy_pass vpn_core_connect_proxy_backend;
    proxy_connect_timeout 10s;
    proxy_timeout 3600s;
}
