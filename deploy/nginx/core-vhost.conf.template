map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Base HTTP VirtualHost for Midori VPN
# Certbot (--nginx) will automatically inject SSL certificates, port 443, and HTTPS redirect
server {
    listen 80;
    server_name __DOMAIN__;

    # 1. OAuth extension callback
    location = /extension/callback {
        proxy_pass         http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # 2. Sondas de Salud (Liveness & Readiness)
    location ~ ^/(livez|readyz|health)$ {
        proxy_pass         http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 5s;
    }

    # 3. Core & Control REST API
    location /api/ {
        proxy_pass         http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 4. WebSocket Hub (Telemetría en tiempo real)
    location /ws {
        proxy_pass         http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 4b. WireGuard-over-WSS relay. The Core returns 404 unless
    # WSS_TUNNEL_ENABLED=true and validates a device-scoped tunnel token.
    location = /api/v1/tunnel/ws {
        proxy_pass         http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 5. Web Control Panel SPA (Quadlet Podman Rootless en :5173 o fallback Core)
    location / {
        proxy_pass         http://127.0.0.1:__CONTROL_WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
