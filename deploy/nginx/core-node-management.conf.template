server {
    listen __MANAGEMENT_HOST_BIND__:__MANAGEMENT_HTTPS_PORT__ ssl;
    server_name _;

    ssl_certificate __MANAGEMENT_TLS_CERT__;
    ssl_certificate_key __MANAGEMENT_TLS_KEY__;
    ssl_protocols TLSv1.3;
    ssl_session_tickets off;

    location = /health {
        proxy_pass http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_set_header Host $host;
    }
    location = /livez {
        proxy_pass http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_set_header Host $host;
    }
    location = /readyz {
        proxy_pass http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_set_header Host $host;
    }
    location = /api/v1/stats {
        proxy_pass http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_set_header Host $host;
    }
    location ^~ /api/v1/peers {
        proxy_pass http://127.0.0.1:__VPN_CORE_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        client_max_body_size 1m;
    }

    location / {
        return 404;
    }
}
