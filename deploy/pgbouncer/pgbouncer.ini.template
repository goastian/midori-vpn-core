[databases]
__POSTGRES_DB__ = host=__POSTGRES_HOST__ port=__POSTGRES_PORT__ dbname=__POSTGRES_DB__

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir = /run/pgbouncer/private
auth_type = scram-sha-256
auth_file = /run/pgbouncer/private/userlist.txt
admin_users = __PGBOUNCER_ADMIN_USER__
stats_users = __PGBOUNCER_ADMIN_USER__

pool_mode = transaction
max_client_conn = __PGBOUNCER_MAX_CLIENT_CONN__
default_pool_size = __PGBOUNCER_DEFAULT_POOL_SIZE__
min_pool_size = __PGBOUNCER_MIN_POOL_SIZE__
reserve_pool_size = __PGBOUNCER_RESERVE_POOL_SIZE__
reserve_pool_timeout = 5
max_db_connections = __PGBOUNCER_MAX_DB_CONNECTIONS__
max_prepared_statements = 100

server_reset_query = DISCARD ALL
server_check_query = select 1
server_check_delay = 30
server_idle_timeout = 60
client_idle_timeout = 300
query_timeout = 6
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
pidfile = /run/pgbouncer/private/pgbouncer.pid
