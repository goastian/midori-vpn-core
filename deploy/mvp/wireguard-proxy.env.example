# Transport-only preset for the single-node limited beta.
# Merge with a COMPLETE principal environment using deploy/host/patch-env.sh.
# This is not a runnable .env and does not certify or activate any transport.
# TLS terminates in the host Nginx stream listener; Core is loopback-only.
PROXY_ENABLED=true
PROXY_TLS_ENABLED=false
PROXY_TLS_TERMINATED_BY_NGINX=true
WSS_TUNNEL_ENABLED=false
MASQUE_ENABLED=false
OPENVPN_ENABLED=false
IKEV2_ENABLED=false
NODE_EXTERNAL_TRANSPORTS=
