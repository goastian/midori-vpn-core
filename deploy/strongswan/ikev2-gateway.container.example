[Unit]
Description=MidoriVPN strongSwan 6 IKEv2 rootful gateway
After=network-online.target
Wants=network-online.target
Conflicts=midorivpn-ikev2.service

[Container]
Image=localhost/midorivpn-ikev2:2.0.0
ContainerName=midori-ikev2
Network=host
DropCapability=all
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true
EnvironmentFile=/etc/midorivpn/ikev2.env
Environment=IKEV2_CA_CERT=/etc/midorivpn/pki/client-ca.pem
Environment=IKEV2_GATEWAY_CERT=/etc/midorivpn/pki/gateway.crt
Environment=IKEV2_GATEWAY_KEY=/etc/midorivpn/pki/gateway.key
Environment=IKEV2_HEALTH_BINARY=/usr/local/bin/ikev2-health
Volume=/etc/midorivpn/pki:/etc/midorivpn/pki:ro
Volume=/run/midorivpn-health:/run/midorivpn-health:rw
Tmpfs=/run/midorivpn-ikev2:rw,nodev,nosuid,noexec,mode=0700
Tmpfs=/run/strongswan:rw,nodev,nosuid,noexec,mode=0755
Tmpfs=/tmp:rw,nodev,nosuid,noexec,mode=0700

[Service]
Restart=on-failure
TimeoutStartSec=90
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
