ARG GO_IMAGE=docker.io/library/golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
ARG RUNTIME_IMAGE=registry.opensuse.org/opensuse/tumbleweed@sha256:eaf3d9ddc0b4542e190fb86652c9c6adcc8fbde482ebb2d328101cbbc8f21efe
ARG STRONGSWAN_VERSION=6.1.0-2.1

FROM ${GO_IMAGE} AS health_builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ikev2-health ./cmd/ikev2-health
COPY internal/ikev2health ./internal/ikev2health
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/ikev2-health ./cmd/ikev2-health

FROM ${RUNTIME_IMAGE}
ARG STRONGSWAN_VERSION
RUN zypper --non-interactive install --no-recommends \
      bash ca-certificates coreutils curl iproute2 nftables openssl sed \
      "strongswan=${STRONGSWAN_VERSION}" && \
    zypper clean --all && \
    /usr/libexec/ipsec/charon --version | grep -Fq 'strongSwan 6.1.0'

COPY --from=health_builder /out/ikev2-health /usr/local/bin/ikev2-health
COPY deploy/strongswan/strongswan.conf.template /usr/share/midorivpn/strongswan/strongswan.conf.template
COPY deploy/strongswan/swanctl.conf.template /usr/share/midorivpn/strongswan/swanctl.conf.template
COPY deploy/strongswan/entrypoint.sh /usr/local/bin/midorivpn-ikev2-entrypoint

RUN chmod 0755 /usr/local/bin/ikev2-health /usr/local/bin/midorivpn-ikev2-entrypoint

EXPOSE 500/udp 4500/udp
ENTRYPOINT ["/usr/local/bin/midorivpn-ikev2-entrypoint"]
