IKEV2_SERVER_NAME=vpn.example.com
IKEV2_NETWORK_CIDR=10.85.0.0/24
VPN_DNS=10.85.0.1
VPN_CLIENT_CRL_URL=https://vpn.example.com/pki/client.crl
IKEV2_PORT=500
IKEV2_NAT_T_PORT=4500
IKEV2_CA_CERT=/etc/midorivpn/pki/client-ca.pem
IKEV2_GATEWAY_CERT=/etc/midorivpn/pki/gateway.crt
IKEV2_GATEWAY_KEY=/etc/midorivpn/pki/gateway.key
