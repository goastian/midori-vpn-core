[Unit]
Description=MidoriVPN OpenVPN 2.7 DCO gateway
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/midorivpn/openvpn.env
Conflicts=midori-openvpn.service

[Service]
Type=simple
EnvironmentFile=/etc/midorivpn/openvpn.env
Environment=OPENVPN_DEPLOYMENT_MODE=host
ExecStart=/usr/local/libexec/midorivpn-openvpn-entrypoint
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

User=root
Group=root
UMask=0077
RuntimeDirectory=midorivpn-openvpn
RuntimeDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/run/midorivpn-openvpn /run/midorivpn-health

[Install]
WantedBy=multi-user.target
