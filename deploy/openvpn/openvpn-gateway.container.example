[Unit]
Description=MidoriVPN OpenVPN 2.7 DCO rootful gateway
After=network-online.target
Wants=network-online.target
Conflicts=midorivpn-openvpn.service

[Container]
Image=localhost/midorivpn-openvpn:2.0.0
ContainerName=midori-openvpn
Network=host
DropCapability=all
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddCapability=NET_BIND_SERVICE
AddDevice=/dev/net/tun
NoNewPrivileges=true
ReadOnly=true
EnvironmentFile=/etc/midorivpn/openvpn.env
Environment=OPENVPN_DEPLOYMENT_MODE=rootful
Environment=OPENVPN_CA_CERT=/etc/midorivpn/pki/client-ca.pem
Environment=OPENVPN_GATEWAY_CERT=/etc/midorivpn/pki/gateway.crt
Environment=OPENVPN_GATEWAY_KEY=/etc/midorivpn/pki/gateway.key
Environment=OPENVPN_HEALTH_BINARY=/usr/local/bin/openvpn-health
Volume=/etc/midorivpn/pki:/etc/midorivpn/pki:ro
Volume=/run/midorivpn-health:/run/midorivpn-health:rw
Tmpfs=/run/midorivpn-openvpn:rw,nodev,nosuid,noexec,mode=0700
Tmpfs=/tmp:rw,nodev,nosuid,noexec,mode=0700

[Service]
Restart=on-failure
TimeoutStartSec=90
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
