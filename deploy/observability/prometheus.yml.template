global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: __OBSERVABILITY_CLUSTER__
    role: principal

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: midorivpn-core
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets:
          - __VPN_CORE_METRICS_TARGET__
        labels:
          cluster: __OBSERVABILITY_CLUSTER__
          node: __CORE_NODE_NAME__
          role: principal
