global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: __OBSERVABILITY_CLUSTER__
    role: principal

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: midorivpn-principal-core
    metrics_path: /metrics
    scheme: https
    scrape_timeout: 10s
    tls_config:
      ca_file: /etc/prometheus/mtls/ca.crt
      cert_file: /etc/prometheus/mtls/client.crt
      key_file: /etc/prometheus/mtls/client.key
      min_version: TLS13
    static_configs:
      - targets:
          - __VPN_CORE_METRICS_TARGET__
        labels:
          cluster: __OBSERVABILITY_CLUSTER__
          node: __CORE_NODE_NAME__
          role: principal

  - job_name: midorivpn-regional-core
    metrics_path: /metrics
    scheme: https
    scrape_timeout: 10s
    http_sd_configs:
      - url: https://__VPN_CORE_METRICS_TARGET__/api/v1/observability/targets
        refresh_interval: 30s
        follow_redirects: false
        tls_config:
          ca_file: /etc/prometheus/mtls/ca.crt
          cert_file: /etc/prometheus/mtls/client.crt
          key_file: /etc/prometheus/mtls/client.key
          min_version: TLS13
    tls_config:
      ca_file: /etc/prometheus/mtls/ca.crt
      cert_file: /etc/prometheus/mtls/client.crt
      key_file: /etc/prometheus/mtls/client.key
      min_version: TLS13
