# ═══════════════════════════════════════════════════════════════════════════
# midori-vpn-core — Variables de entorno
# ═══════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y reemplaza los valores de ejemplo.
#
# Reglas prácticas:
# - No subas .env al repositorio; ahí van secretos reales.
# - Para un Core externo, puedes usar scripts/setup-core-host.sh.
# - Para un nodo con Control, completa también la sección Control/Auth.
# - DATABASE_URL y REDIS_URL son overrides manuales; en Docker normalmente se
#   dejan vacías para que la app construya las URLs desde POSTGRES_* y REDIS_*.

# ─── Aplicación ───────────────────────────────────────────────────────────
# Entorno de ejecución. En production se ocultan detalles internos de errores
# en respuestas HTTP.
APP_ENV=production

# Dominio público de este nodo. Debe resolver al host donde corre nginx.
# Certbot y el vhost del host usan este valor para TLS.
DOMAIN=vpn.example.com

# Puerto solo-local del host donde Docker publica el API HTTP del Core.
# Nginx del host hace proxy a 127.0.0.1:VPN_CORE_HOST_PORT.
# No expongas este puerto públicamente.
VPN_CORE_HOST_PORT=8085

# ─── HTTP API ─────────────────────────────────────────────────────────────
# Puerto HTTP interno del contenedor. El TLS termina en nginx del host.
VPN_CORE_PORT=8080

# Token compartido para proteger el Core API con el header X-Core-Token.
# Debe ser fuerte y único por nodo Core. Control guarda este valor al registrar
# cada servidor.
VPN_CORE_TOKEN=change-me-to-a-strong-secret

# ─── WireGuard ────────────────────────────────────────────────────────────
# Nombre de la interfaz WireGuard creada por el Core.
WG_INTERFACE=wg0

# Puerto UDP público para clientes WireGuard.
WG_PORT=51820

# Subred privada para asignar IPs a peers. Debe estar en formato CIDR.
WG_SUBNET=10.8.0.0/16

# Directorio persistente donde se guarda la configuración WireGuard.
WG_CONFIG_DIR=/etc/wireguard

# Host/IP que reciben los clientes en su configuración WireGuard.
# Normalmente coincide con DOMAIN.
WG_ENDPOINT=vpn.example.com

# ─── Almacenamiento ───────────────────────────────────────────────────────
# docker-compose-prod.yml levanta PostgreSQL y Redis para este nodo.
# No hay dos bases: solo POSTGRES_DB. La misma contraseña de POSTGRES_PASSWORD
# configura el contenedor y permite que vpn-core construya DATABASE_URL.
POSTGRES_USER=midori
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=midori_vpn
POSTGRES_SSLMODE=disable

# Sobrescritura manual de conexión PostgreSQL. Déjala vacía en despliegues
# Docker normales para evitar duplicar usuario/password/host.
DATABASE_URL=

# Redis usa el mismo patrón: una sola contraseña y URL generada por la app.
REDIS_PASSWORD=change-me-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Sobrescritura manual de conexión Redis. Déjala vacía si usas Redis del compose.
REDIS_URL=

# ─── Control/Auth ─────────────────────────────────────────────────────────
# Un Core externo no necesita Authentik: el login de usuarios ocurre en Control.
# El Core externo queda protegido por TLS y X-Core-Token.
#
# Completa estas variables solo en el nodo donde estará habilitada la API
# Control. Si AUTHENTIK_CLIENT_ID queda vacío, Control queda deshabilitado.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_JWKS_URL=

# Base pública usada por Control para callbacks, frontend y CORS.
# En Core externo puede quedar como el dominio del nodo, aunque Control esté
# deshabilitado.
PUBLIC_BASE_URL=https://vpn.example.com
CORS_ALLOWED_ORIGINS=https://vpn.example.com

# Usa staging para probar Certbot sin consumir límites de Let's Encrypt.
# Cambia a false cuando DOMAIN ya apunte correctamente al host.
LETSENCRYPT_STAGING=true

# Proxy HTTP CONNECT para modo navegador/extension.
# Si PROXY_ENABLED=false, los servidores quedan sin soporte proxy para la
# extension (supports_proxy=false) y no aparecerán como elegibles.
# PROXY_PORT es el puerto interno donde vpn-core escucha dentro del contenedor.
# PROXY_HOST_PORT es el puerto loopback del host usado como upstream de nginx
# stream{} (por ejemplo 127.0.0.1:18888 -> container:8888).
# El puerto público para clientes/extension lo atiende nginx stream (ej. 8888).
PROXY_ENABLED=false
PROXY_PORT=8888
PROXY_HOST_PORT=18888

# ─── Límites De Peticiones ────────────────────────────────────────────────
# Máximo de requests por segundo por IP. Usa 0 para deshabilitar.
RATE_LIMIT_RPS=20

# Ráfaga permitida por encima del límite sostenido.
RATE_LIMIT_BURST=40

# ─── Límites De Dispositivos ─────────────────────────────────────────────
# Máximo de conexiones VPN activas por usuario. Usa 0 para ilimitado.
MAX_DEVICES_PER_USER=5

# ─── Core-to-Core TLS ────────────────────────────────────────────────────
# Control llama a los Core registrados por HTTPS por defecto.
# Cada Core debe tener TLS válido delante, normalmente con nginx del host en 443.
#
# No saltes verificación TLS en producción. Si usas CA privada, instálala en el
# trust store del contenedor en vez de poner esto en true.
CORE_TLS_SKIP_VERIFY=false

# Permite HTTP sin TLS para llamadas Control -> Core.
# Solo debería usarse en desarrollo o redes internas muy controladas.
CORE_ALLOW_INSECURE_HTTP=false

# Lista permitida de hostnames Core que Control puede llamar.
# Usa solo hostnames, sin esquema ni puerto.
CORE_ALLOWED_HOSTS=vpn.example.com

# IPs/CIDRs de proxies confiables. Como nginx corre en el host y entra al
# contenedor por el bridge de Docker/Podman, el valor por defecto cubre rangos
# privados comunes de contenedores. Endurécelo si conoces la subred exacta.
TRUSTED_PROXIES=172.16.0.0/12

# ─── Comportamiento De Control API ────────────────────────────────────────
# Control queda deshabilitado mientras AUTHENTIK_CLIENT_ID esté vacío.
# Cuando habilites Control, también debe existir conexión a PostgreSQL y Redis.
#
# Jobs de Control:
#   - Stats sync: consulta periódicamente los Core registrados.
#   - Peer cleanup: desactiva peers vencidos o inactivos.
#
# WebSocket:
#   - /ws emite estadísticas agregadas a clientes autenticados.
#
