# ═══════════════════════════════════════════════════════════════════════════
# midori-vpn-core — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Variables without defaults are REQUIRED if Control API is enabled.

# ─── Application ─────────────────────────────────────────────────────────
# Environment: "production" or "development".
# In production, internal error details are hidden from API responses.
APP_ENV=production

# ─── HTTP API ─────────────────────────────────────────────────────────────
# Port for the unified HTTP server (WireGuard core + Control API)
VPN_CORE_PORT=8080

# Shared secret for core-to-core API authentication (X-Core-Token header).
# MUST be a strong random string. All /api/v1/* requests are rejected if empty.
VPN_CORE_TOKEN=change-me-to-a-strong-secret

# ─── WireGuard ────────────────────────────────────────────────────────────
# Network interface name for WireGuard
WG_INTERFACE=wg0

# UDP listen port for WireGuard
WG_PORT=51820

# IP subnet for peer allocation (CIDR). The core assigns IPs from this pool.
WG_SUBNET=10.8.0.0/16

# Directory where wg0.conf is stored
WG_CONFIG_DIR=/etc/wireguard

# Public IP or hostname that clients use to reach this WireGuard endpoint.
# This is sent to clients in their connection config.
WG_ENDPOINT=your-server-public-ip

# ─── PostgreSQL (required for Control API) ────────────────────────────────
# If empty, the Control API is disabled and only WireGuard core runs.
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://midori:midori@postgres:5432/midori_vpn?sslmode=disable

# ─── Redis (optional, for session caching) ────────────────────────────────
# Format: redis://host:port/db
REDIS_URL=redis://redis:6379/0

# ─── Authentik OIDC (required for Control API) ────────────────────────────
# Base issuer URL from Authentik (without trailing slash).
# Used to validate JWT token issuer claim.
AUTHENTIK_ISSUER=https://accounts.astian.org/application/o/midorivpn

# OAuth2 Client ID from Authentik application configuration.
AUTHENTIK_CLIENT_ID=your-authentik-client-id

# JWKS endpoint for JWT signature validation.
# If empty, derived automatically as {AUTHENTIK_ISSUER}/jwks/
AUTHENTIK_JWKS_URL=https://accounts.astian.org/application/o/midorivpn/jwks/

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Supports wildcard subdomains like https://*.astian.org
CORS_ALLOWED_ORIGINS=https://*.astian.org,http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────────────────────────
# Maximum requests per second per IP address. Set to 0 to disable.
RATE_LIMIT_RPS=20

# Burst size — allows short bursts above the RPS limit.
RATE_LIMIT_BURST=40

# ─── Device Limits ──────────────────────────────────────────────────────
# Maximum number of active VPN connections per user. Set to 0 for unlimited.
MAX_DEVICES_PER_USER=5

# ─── Core-to-Core TLS ────────────────────────────────────────────────────
# Skip TLS certificate verification for core-to-core communication.
# Set to true only if using self-signed certificates in a trusted network.
CORE_TLS_SKIP_VERIFY=false

# ─── Control API Behavior ─────────────────────────────────────────────────
# The Control API is enabled ONLY when both DATABASE_URL and
# AUTHENTIK_CLIENT_ID are set. Otherwise the binary runs as a
# standalone WireGuard core daemon.
#
# Background jobs:
#   - Stats sync:    every 60s — polls all registered core nodes for
#                    peer stats and updates the database.
#   - Peer cleanup:  every 5min — deactivates peers that are expired
#                    or have no handshake in the last 30 minutes.
#
# WebSocket:
#   - /ws endpoint broadcasts aggregated stats to connected clients
#     every 60s (tied to the stats sync job).
#