# Midori VPN Core 2.0.0
# Copy to .env and replace every <required-...> value before startup.
# Empty values are optional only where the comment explicitly says so.

# Runtime and public routing
DEPLOYMENT_PROFILE=<required-principal-or-core-node>
CORE_NODE_NAME=<required-lowercase-node-name>
APP_ENV=<required-production-or-development>
CORE_IMAGE=<required-fully-qualified-core-image>
CONTROL_IMAGE=<required-fully-qualified-control-image>
POSTGRES_IMAGE=docker.io/library/postgres:18.6-alpine
REDIS_IMAGE=docker.io/library/redis:8.10.1-alpine
VPN_CORE_PORT=<required-container-http-port>
VPN_CORE_HOST_PORT=<required-loopback-host-port>
CONTROL_CONTAINER_PORT=<required-container-http-port>
CONTROL_HOST_PORT=<required-loopback-host-port>
DOMAIN=<required-public-hostname>
PUBLIC_BASE_URL=<required-https-base-url>
CORS_ALLOWED_ORIGINS=<required-comma-separated-origins>
TRUSTED_PROXIES=<required-in-production-comma-separated-ip-or-cidr-list>
EXTENSION_CALLBACK_PATH=<required-callback-path>
# Optional exact comma-separated moz-extension:// / chrome-extension:// origins.
# When empty, a successful first PKCE callback registers the exact origin in DB.
ALLOWED_EXTENSION_ORIGINS=

# Signed node-to-node authentication
CONTROL_NODE_ID=
CONTROL_NODE_PRIVATE_KEY=
NODE_AUTHORIZED_KEYS=<required-node-id-equals-base64url-ed25519-public-key>
NODE_REVOKED_IDS=
NODE_AUTH_REDIS_URL=<required-in-production-authenticated-redis-url>
CREDENTIAL_SIGNING_SECRET=<required-when-control-proxy-or-wss-is-enabled>

# WireGuard
WG_INTERFACE=<required-interface-name>
WG_PORT=<required-public-udp-port>
WG_SUBNET=<required-cidr>
WG_CONFIG_DIR=<required-absolute-directory>
WG_ENDPOINT=<required-public-host-or-ip-without-port>
VPN_DNS=<required-comma-separated-dns-ip-list>

# Optional shared client PKI for OpenVPN/IKEv2. Configure both paths or
# neither. Device private keys are generated client-side and never mounted.
VPN_CLIENT_CA_CERT=
VPN_CLIENT_CA_KEY=
VPN_CLIENT_CERT_TTL_HOURS=2160
VPN_CLIENT_CRL_URL=

# PostgreSQL. Set DATABASE_URL, or fill every POSTGRES_* value. Leave all of
# them empty only on an Edge node that does not host the Control API.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_SSLMODE=

# Redis used by Control jobs. Set REDIS_URL, or fill every REDIS_* value.
REDIS_URL=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

# Authentik/OIDC. Leave the whole group empty only when Control is disabled.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
# Public PKCE clients leave this empty. Configure it only when the provider is
# deliberately registered as a confidential server-side client.
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_JWKS_URL=
AUTHENTIK_INTROSPECTION_URL=
OAUTH_ALLOWED_REDIRECT_URIS=
CONTROL_OAUTH_REDIRECT_URI=

# Core-to-Core transport policy
CORE_TLS_SKIP_VERIFY=<required-true-or-false>
CORE_ALLOW_INSECURE_HTTP=<required-true-or-false>
CORE_ALLOWED_HOSTS=<required-in-production-comma-separated-hostnames>

# HTTP and connection rate limits
RATE_LIMIT_RPS=<required-non-negative-integer>
RATE_LIMIT_BURST=<required-positive-integer-when-enabled>
CONNECT_RATE_LIMIT_RPS=<required-non-negative-number>
CONNECT_RATE_LIMIT_BURST=<required-positive-integer-when-enabled>
MAX_DEVICES_PER_USER=<required-non-negative-integer>

# Authenticated HTTPS CONNECT proxy
PROXY_ENABLED=<required-true-or-false>
PROXY_PORT=<required-tcp-port>
PROXY_HOST_PORT=<required-loopback-host-port>
PROXY_MAX_CONNS_PER_USER=<required-positive-integer>
PROXY_TLS_ENABLED=<required-true-or-false>
PROXY_TLS_TERMINATED_BY_NGINX=<required-true-or-false>
PROXY_TLS_CERT=
PROXY_TLS_KEY=

# Authenticated WireGuard-over-WebSocket relay
WSS_TUNNEL_ENABLED=<required-true-or-false>
WSS_TUNNEL_SERVER_ID=
WSS_TUNNEL_MAX_CLIENTS=<required-positive-integer>

# Authenticated WireGuard-over-MASQUE (RFC 9298). The URI template must use
# target_host and target_port variables. TLS terminates in Core on UDP.
MASQUE_ENABLED=<required-true-or-false>
MASQUE_PORT=<required-public-udp-port>
MASQUE_TLS_CERT=
MASQUE_TLS_KEY=
MASQUE_URI_TEMPLATE=
MASQUE_SERVER_ID=
MASQUE_MAX_CLIENTS=<required-positive-integer>

# Authenticated browser WebSocket limits
WS_MAX_GLOBAL=<required-non-negative-integer>
WS_MAX_FREE=<required-non-negative-integer>
WS_MAX_BASIC=<required-non-negative-integer>
WS_MAX_MEDIUM=<required-non-negative-integer>
WS_MAX_PRO=<required-non-negative-integer>
WS_MAX_ADMIN=<required-non-negative-integer>

# Optional Astian Payment integration; configure both values or neither.
ASTIAN_PAYMENT_URL=
ASTIAN_PAYMENT_INTERNAL_TOKEN=

# Host TLS automation
LETSENCRYPT_STAGING=<required-true-or-false>
CERTBOT_EMAIL=<required-certificate-contact-email>
ACME_WEBROOT=<required-absolute-webroot-path>
NGINX_VHOST_PATH=<required-absolute-http-vhost-path>
NGINX_STREAM_VHOST_PATH=
