# Midori VPN Core 2.0.0
# Copy to .env and replace every <required-...> value before startup.
# Empty values are optional only where the comment explicitly says so.

# Runtime and public routing
DEPLOYMENT_PROFILE=<required-principal-or-core-node>
CORE_NODE_NAME=<required-lowercase-node-name>
APP_ENV=<required-production-or-development>
CORE_IMAGE=<required-fully-qualified-core-image>
CONTROL_IMAGE=<required-fully-qualified-control-image>
POD_INFRA_IMAGE=registry.k8s.io/pause@sha256:e5b941ef8f71de54dc3a13398226c269ba217d06650a21bd3afcf9d890cf1f41
POSTGRES_IMAGE=<required-postgres-18-image-by-digest>
PGBOUNCER_IMAGE=<required-pgbouncer-1.25.2-image>
REDIS_IMAGE=<required-redis-8-image-by-digest>
# Verified release lines on 2026-09-03: Prometheus 3.14.0 and Grafana 13.2.1.
# Production values still require the registry's immutable multi-arch digest.
PROMETHEUS_IMAGE=<required-prometheus-3.14.0-image-by-digest>
GRAFANA_IMAGE=<required-grafana-13.2.1-image-by-digest>
VPN_CORE_PORT=<required-container-http-port>
VPN_CORE_HOST_PORT=<required-loopback-host-port>
CONTROL_CONTAINER_PORT=<required-container-http-port>
CONTROL_HOST_PORT=<required-loopback-host-port>
PROMETHEUS_HOST_PORT=<required-loopback-host-port>
GRAFANA_HOST_PORT=<required-loopback-host-port>
DOMAIN=<required-public-hostname>
PUBLIC_BASE_URL=<required-https-base-url>
CORS_ALLOWED_ORIGINS=<required-comma-separated-origins>
TRUSTED_PROXIES=<required-in-production-comma-separated-ip-or-cidr-list>
EXTENSION_CALLBACK_PATH=<required-callback-path>
# Optional exact comma-separated moz-extension:// / chrome-extension:// origins.
# When empty, a successful first PKCE callback registers the exact origin in DB.
ALLOWED_EXTENSION_ORIGINS=

# Signed node-to-node authentication
CONTROL_NODE_ID=
CONTROL_NODE_PRIVATE_KEY=
NODE_AUTHORIZED_KEYS=<required-node-id-equals-base64url-ed25519-public-key>
NODE_REVOKED_IDS=
NODE_AUTH_REDIS_URL=<required-in-production-authenticated-redis-url>
# Ed25519 mvpn2 transport credentials. Only the principal has the private key
# above. Every Core receives this dedicated public trust store and exact issuer.
TRANSPORT_TOKEN_ISSUER=<required-control-https-origin>
TRANSPORT_TOKEN_AUTHORIZED_KEYS=<required-control-key-id-equals-base64url-ed25519-public-key>
TRANSPORT_CLUSTER_ID=<required-cluster-uuid-on-transport-gateways>
ALLOW_LEGACY_HMAC_TRANSPORT_TOKENS=false
# Development-only, and rejected unless the explicit option above is true.
CREDENTIAL_SIGNING_SECRET=

# Dedicated private metrics listener. Production profiles require TLS 1.3,
# a verified Prometheus client certificate and this exact URI SAN.
OBSERVABILITY_MTLS_PORT=9443
OBSERVABILITY_TLS_CERT=<required-absolute-server-certificate-path>
OBSERVABILITY_TLS_KEY=<required-absolute-0600-server-key-path>
OBSERVABILITY_CLIENT_CA=<required-absolute-client-ca-path>
OBSERVABILITY_ALLOWED_CLIENT_URI=spiffe://midorivpn/observability/prometheus
# Regional deployer only: exact RFC1918 address used for the host bind.
OBSERVABILITY_HOST_BIND=
# Node-to-Control enrollment and heartbeat identity. Required together for
# every regional and enrolled principal node. A fresh principal may leave all
# six values empty only for its initial administrative bootstrap. The host
# directory must be private (0700). Place the one-use token in its
# enrollment-token file with mode 0600; Core overwrites and removes that file
# after successful enrollment.
NODE_CONTROL_URL=<required-https-control-origin>
CORE_NODE_ID=<required-control-issued-uuid>
CORE_NODE_STATE_DIR=/var/lib/midorivpn-node
CORE_NODE_STATE_HOST_DIR=<required-absolute-private-host-directory>
CORE_NODE_ENROLLMENT_TOKEN_FILE=/var/lib/midorivpn-node/enrollment-token
CORE_NODE_MAX_PEERS=<required-positive-capacity>
# Optional comma-separated local names and SHA-256 fingerprints used to prove
# that a signed desired-state secret reference exists on this node. Values are
# references only, never secret material: name=64-lowercase-hex.
NODE_SECRET_FINGERPRINTS=
# Optional host gateways that belong to this logical node but execute outside
# Core. Only unique lowercase openvpn and/or ikev2 values are accepted. Declare
# a protocol only when its private health adapter is installed on this node.
NODE_EXTERNAL_TRANSPORTS=
# Principal-only XChaCha20-Poly1305 key: canonical padded base64 for exactly
# 32 random bytes. Back it up separately; losing it makes stored PSKs unreadable.
CONTROL_DATA_ENCRYPTION_KEY=

# WireGuard
WG_INTERFACE=<required-interface-name>
WG_PORT=<required-public-udp-port>
# IPv4 only. Prefixes from /16 through /30 are supported (at most 65,536 addresses).
WG_SUBNET=<required-cidr>
WG_CONFIG_DIR=<required-absolute-directory>
WG_ENDPOINT=<required-public-host-or-ip-without-port>
VPN_DNS=<required-comma-separated-dns-ip-list>

# Optional shared client PKI for OpenVPN/IKEv2. Configure both paths or
# neither. Device private keys are generated client-side and never mounted.
VPN_CLIENT_CA_CERT=
VPN_CLIENT_CA_KEY=
VPN_CLIENT_CERT_TTL_HOURS=2160
VPN_CLIENT_CRL_URL=

# PostgreSQL 18 principal. The bootstrap administrator is retained only for
# controlled maintenance; Core receives only the runtime role. The migrator is
# used by the one-shot migration container and never by the long-lived Core.
# Owner, migrator, runtime and PgBouncer administrator names must be distinct.
POSTGRES_ADMIN_USER=<required-bootstrap-administrator>
POSTGRES_ADMIN_PASSWORD=<required-private-administrator-password>
POSTGRES_OWNER_ROLE=<required-no-login-owner-role>
POSTGRES_MIGRATOR_USER=<required-migrator-role>
POSTGRES_MIGRATOR_PASSWORD=<required-private-migrator-password>
POSTGRES_RUNTIME_USER=<required-runtime-role>
POSTGRES_RUNTIME_PASSWORD=<required-private-runtime-password>
POSTGRES_BACKUP_USER=<required-read-only-backup-role>
POSTGRES_BACKUP_PASSWORD=<required-private-backup-password>
PGBOUNCER_ADMIN_USER=<required-pooler-administrator>
PGBOUNCER_ADMIN_PASSWORD=<required-private-pooler-password>
POSTGRES_DB=<required-database-name>
# Temporary custom-format backup destination. It must be a private 0700
# directory; dumps and checksum manifests are created with mode 0600.
POSTGRES_BACKUP_DIR=<required-absolute-private-backup-directory>

# Direct URLs are supported for non-pod orchestration. The standard principal
# deployer overrides these endpoints to PostgreSQL:5432 for migrations and
# PgBouncer:6432 for runtime inside the private pod.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_SSLMODE=
MIGRATION_DATABASE_URL=
POSTGRES_MIGRATION_HOST=
POSTGRES_MIGRATION_PORT=
POSTGRES_MIGRATION_SSLMODE=

# Initial measured pool envelope. Revalidate before increasing it; the Core
# pool must fit below PgBouncer's per-database backend ceiling.
DATABASE_POOL_MAX_CONNS=16
DATABASE_POOL_MIN_CONNS=2
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=16
PGBOUNCER_MIN_POOL_SIZE=2
PGBOUNCER_RESERVE_POOL_SIZE=4
PGBOUNCER_MAX_DB_CONNECTIONS=24

# Redis used by Control jobs. Set REDIS_URL, or fill every REDIS_* value.
REDIS_URL=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

# Authentik/OIDC. Leave the whole group empty only when Control is disabled.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
# Public PKCE clients leave this empty. Configure it only when the provider is
# deliberately registered as a confidential server-side client.
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_JWKS_URL=
AUTHENTIK_INTROSPECTION_URL=
OAUTH_ALLOWED_REDIRECT_URIS=
CONTROL_OAUTH_REDIRECT_URI=

# Core-to-Core transport policy
CORE_TLS_SKIP_VERIFY=<required-true-or-false>
CORE_ALLOW_INSECURE_HTTP=<required-true-or-false>
CORE_ALLOWED_HOSTS=<required-in-production-comma-separated-hostnames>

# HTTP and connection rate limits
RATE_LIMIT_RPS=<required-non-negative-integer>
RATE_LIMIT_BURST=<required-positive-integer-when-enabled>
CONNECT_RATE_LIMIT_RPS=<required-non-negative-number>
CONNECT_RATE_LIMIT_BURST=<required-positive-integer-when-enabled>
MAX_DEVICES_PER_USER=<required-non-negative-integer>

# Authenticated HTTPS CONNECT proxy
PROXY_ENABLED=<required-true-or-false>
PROXY_PORT=<required-tcp-port>
PROXY_HOST_PORT=<required-loopback-host-port>
PROXY_MAX_CONNS_PER_USER=<required-positive-integer>
PROXY_TLS_ENABLED=<required-true-or-false>
PROXY_TLS_TERMINATED_BY_NGINX=<required-true-or-false>
PROXY_TLS_CERT=
PROXY_TLS_KEY=
PROXY_SERVER_ID=

# Authenticated WireGuard-over-WebSocket relay
WSS_TUNNEL_ENABLED=<required-true-or-false>
WSS_TUNNEL_SERVER_ID=
WSS_TUNNEL_MAX_CLIENTS=<required-positive-integer>

# Authenticated WireGuard-over-MASQUE (RFC 9298). The URI template must use
# target_host and target_port variables. TLS terminates in Core on UDP.
MASQUE_ENABLED=<required-true-or-false>
MASQUE_PORT=<required-public-udp-port>
MASQUE_TLS_CERT=
MASQUE_TLS_KEY=
MASQUE_URI_TEMPLATE=
MASQUE_SERVER_ID=
MASQUE_MAX_CLIENTS=<required-positive-integer>

# Authenticated browser WebSocket limits
WS_MAX_GLOBAL=<required-non-negative-integer>
WS_MAX_FREE=<required-non-negative-integer>
WS_MAX_BASIC=<required-non-negative-integer>
WS_MAX_MEDIUM=<required-non-negative-integer>
WS_MAX_PRO=<required-non-negative-integer>
WS_MAX_ADMIN=<required-non-negative-integer>

# Optional Astian Payment integration; configure both values or neither.
ASTIAN_PAYMENT_URL=
ASTIAN_PAYMENT_INTERNAL_TOKEN=

# Host TLS automation
LETSENCRYPT_STAGING=<required-true-or-false>
CERTBOT_EMAIL=<required-certificate-contact-email>
ACME_WEBROOT=<required-absolute-webroot-path>
NGINX_VHOST_PATH=<required-absolute-http-vhost-path>
NGINX_STREAM_VHOST_PATH=

# Private observability. Grafana is loopback-only and has its own minimal env
# file; these credentials are never passed to Core or stored in rendered YAML.
OBSERVABILITY_CONFIG_DIR=<required-absolute-private-directory>
OBSERVABILITY_CLUSTER=<required-lowercase-cluster-label>
OBSERVABILITY_NETWORK=<required-private-podman-network>
VPN_CORE_METRICS_TARGET=<required-core-private-dns-name-and-9443>
PROMETHEUS_MTLS_CA=<required-absolute-observability-ca-path>
PROMETHEUS_MTLS_CLIENT_CERT=<required-absolute-client-certificate-path>
PROMETHEUS_MTLS_CLIENT_KEY=<required-absolute-0600-client-key-path>
GRAFANA_ADMIN_USER=<required-admin-user>
GRAFANA_ADMIN_PASSWORD=<required-strong-password>
