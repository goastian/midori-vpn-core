# ==============================================================================
# Midori VPN — Servidor Core de Producción (.env.example)
# ==============================================================================

# Entorno general
APP_ENV=production
LOG_LEVEL=info
PORT=8080
PUBLIC_BASE_URL=https://vpn.astian.org

# Base de datos central (PostgreSQL 18)
DATABASE_URL=postgres://midori:YOUR_STRONG_PG_PASSWORD@127.0.0.1:5432/midori_vpn?sslmode=disable
POSTGRES_USER=midori
POSTGRES_PASSWORD=YOUR_STRONG_PG_PASSWORD
POSTGRES_DB=midori_vpn

# Caché y limitador de tasa distribuido (Redis 7)
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@127.0.0.1:6379/0
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD

# Autenticación Central (Astian Accounts / Authentik OIDC)
AUTHENTIK_ISSUER=https://accounts.astian.org/application/o/midori-vpn/
AUTHENTIK_CLIENT_ID=60mBgw8BHTvKRPYVhDTJGoKEt30QYG3b7Sv0RFNd
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://vpn.astian.org/auth/callback
AUTHENTIK_JWKS_URL=https://accounts.astian.org/application/o/midori-vpn/jwks/

# Token de administración interna entre Core y Nodos Edge (64+ caracteres)
VPN_CORE_TOKEN=GENERATE_SECURE_64_CHAR_TOKEN_HERE

# WireGuard Servidor
WG_INTERFACE=wg0
WG_PORT=51820
WG_SUBNET=10.8.0.0/16
WG_CONFIG_DIR=/etc/wireguard
WG_ENDPOINT=vpn.astian.org:51820

# Seguridad de CORS
CORS_ALLOWED_ORIGINS=https://vpn.astian.org,https://astian.org
